# Fixed single-account credentials (generate with: openssl rand -hex 20)
ACCESS_KEY_ID=changeme_access_key_id
SECRET_ACCESS_KEY=changeme_secret_access_key

# Storage
STORAGE_ROOT=/data
MAX_UPLOAD_SIZE=5368709120

# Public endpoint clients will connect to (used to sign presigned URLs)
PUBLIC_BASE_URL=http://localhost:8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=open_s3
DB_USERNAME=root
DB_PASSWORD=changeme_root_password

# Redis — optional. Leave REDIS_HOST empty/unset (deploy option 3, shared
# hosting) to disable it entirely: events still get written to the `events`
# table, just without the "wake the daemon up immediately" fast path — see
# Cronjobs.php / docs/plans.md section 9.1. Options 1/2 (Docker) need this set.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# Deploy option 3 only (shared hosting): shared secret required by
# GET /cronjobs/process?token=... — generate with: openssl rand -hex 20
CRON_SECRET=changeme_cron_secret
CRON_BATCH_LIMIT=20

# Optional antivirus — the clamav service is commented out in
# docker-compose.yml by default; uncomment it there to enable this.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
ENABLE_VIRUS_SCAN=false

# Environment: development | testing | production
CI_ENV=production
